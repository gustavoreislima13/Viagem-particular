rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------
    // Hardened Global Helpers
    // -----------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Strict Two-Layer Admin Whitelist: ONLY verified Google account reisanselmo7@gmail.com
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'reisanselmo7@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isVerifiedAdminToken() {
      return isAdmin();
    }

    function isValidVipPreferencesMap(prefs) {
      return prefs is map
        && prefs.keys().hasOnly(['acTemp', 'rideStyle', 'favoriteTime', 'favoriteRoute'])
        && (!('acTemp' in prefs) || (prefs.acTemp is string && prefs.acTemp.size() <= 60))
        && (!('rideStyle' in prefs) || (prefs.rideStyle is string && prefs.rideStyle.size() <= 80))
        && (!('favoriteTime' in prefs) || (prefs.favoriteTime is string && prefs.favoriteTime.size() <= 20))
        && (!('favoriteRoute' in prefs) || (prefs.favoriteRoute is string && prefs.favoriteRoute.size() <= 240));
    }

    // -----------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -----------------------------------------------------------------
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'name', 'displayName', 'email', 'phone', 'address', 'cpf',
          'photoUrl', 'photoURL',
          'points', 'pontos', 'tier',
          'vipActive', 'isVip', 'vipSubscribedAt', 'vipExpiresAt', 'profileCompleted',
          'walletBalance', 'pendingPenalty',
          'preferences', 'vipPreferences', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 120))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120))
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('address' in data) || (data.address is string && data.address.size() <= 280))
        && (!('cpf' in data) || (data.cpf is string && data.cpf.size() <= 20))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('points' in data) || (data.points is int && data.points >= 0 && data.points <= 1000000))
        && (!('pontos' in data) || (data.pontos is int && data.pontos >= 0 && data.pontos <= 1000000))
        && (!('tier' in data) || (data.tier is string && data.tier in ['Bronze', 'Prata', 'Ouro', 'Black']))
        && (!('vipActive' in data) || data.vipActive is bool)
        && (!('isVip' in data) || data.isVip is bool)
        && (!('vipSubscribedAt' in data) || data.vipSubscribedAt is timestamp || (data.vipSubscribedAt is string && data.vipSubscribedAt.size() <= 40))
        && (!('vipExpiresAt' in data) || data.vipExpiresAt is timestamp || (data.vipExpiresAt is string && data.vipExpiresAt.size() <= 40))
        && (!('profileCompleted' in data) || data.profileCompleted is bool)
        && (!('walletBalance' in data) || (data.walletBalance is number && data.walletBalance >= 0 && data.walletBalance <= 100000))
        && (!('pendingPenalty' in data) || (data.pendingPenalty is number && data.pendingPenalty >= 0 && data.pendingPenalty <= 10000))
        && (!('preferences' in data) || (data.preferences is string && data.preferences.size() <= 300) || isValidVipPreferencesMap(data.preferences))
        && (!('vipPreferences' in data) || isValidVipPreferencesMap(data.vipPreferences))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'phone', 'address', 'cpf', 'photoURL',
          'preferences', 'vipPreferences', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('address' in data) || (data.address is string && data.address.size() <= 280))
        && (!('cpf' in data) || (data.cpf is string && data.cpf.size() <= 20))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('preferences' in data) || (data.preferences is string && data.preferences.size() <= 300) || isValidVipPreferencesMap(data.preferences))
        && (!('vipPreferences' in data) || isValidVipPreferencesMap(data.vipPreferences))
        && data.updatedAt is timestamp;
    }

    function isValidWalletTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'balanceAfter', 'description', 'createdAt'])
        && data.keys().hasOnly(['userId', 'type', 'amount', 'balanceAfter', 'description', 'referenceCode', 'createdAt'])
        && isValidId(data.userId)
        && data.type is string && data.type in ['recarga', 'corrida', 'multa', 'ajuste_admin', 'estorno']
        && data.amount is number && data.amount >= -100000 && data.amount <= 100000
        && data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 100000
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 240
        && (!('referenceCode' in data) || (data.referenceCode is string && data.referenceCode.size() <= 80))
        && data.createdAt is timestamp;
    }

    function isValidVoucher(data) {
      return data.keys().hasAll(['voucherCode', 'userId', 'title', 'discountValue', 'used', 'createdAt'])
        && data.keys().hasOnly(['voucherCode', 'userId', 'title', 'discountValue', 'pointsCost', 'used', 'createdAt'])
        && isValidId(data.voucherCode)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.discountValue is number && data.discountValue > 0 && data.discountValue <= 500
        && (!('pointsCost' in data) || (data.pointsCost is int && data.pointsCost >= 0 && data.pointsCost <= 100000))
        && data.used is bool
        && data.createdAt is timestamp;
    }

    function isValidScheduleSlot(data) {
      return data.keys().hasAll(['slotId', 'userId', 'sourceType', 'date', 'startTimeIso', 'endTimeIso', 'active', 'updatedAt'])
        && data.keys().hasOnly([
          'slotId', 'userId', 'sourceType', 'referenceCode', 'date', 'returnDate',
          'startTimeIso', 'endTimeIso', 'returnStartTimeIso', 'returnEndTimeIso',
          'startTimeStr', 'endTimeStr', 'reason', 'active', 'updatedAt'
        ])
        && isValidId(data.slotId)
        && isValidId(data.userId)
        && data.sourceType is string && data.sourceType in ['ride', 'manual_block']
        && (!('referenceCode' in data) || (data.referenceCode is string && data.referenceCode.size() <= 80))
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && (!('returnDate' in data) || (data.returnDate is string && data.returnDate.size() <= 20))
        && data.startTimeIso is string && data.startTimeIso.size() >= 10 && data.startTimeIso.size() <= 40
        && data.endTimeIso is string && data.endTimeIso.size() >= 10 && data.endTimeIso.size() <= 40
        && (!('returnStartTimeIso' in data) || (data.returnStartTimeIso is string && data.returnStartTimeIso.size() <= 40))
        && (!('returnEndTimeIso' in data) || (data.returnEndTimeIso is string && data.returnEndTimeIso.size() <= 40))
        && (!('startTimeStr' in data) || (data.startTimeStr is string && data.startTimeStr.size() <= 10))
        && (!('endTimeStr' in data) || (data.endTimeStr is string && data.endTimeStr.size() <= 10))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 200))
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidRide(data) {
      return data.keys().hasAll([
        'rideCode', 'userId', 'clientName', 'originName', 'destinationName',
        'distanceKm', 'durationMin', 'category', 'isRoundTrip',
        'scheduledDate', 'scheduledTime', 'price', 'pointsEarned',
        'status', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'rideCode', 'userId', 'clientName', 'clientEmail', 'clientPhone',
          'originName', 'originAddress', 'originLat', 'originLng',
          'destinationName', 'destinationAddress', 'destinationLat', 'destinationLng',
          'distanceKm', 'durationMin',
          'category', 'isRoundTrip', 'recurrenceFrequency', 'preferences',
          'scheduledDate', 'scheduledTime',
          'totalOccupiedMin', 'safetyMarginMin', 'roundTripMode', 'waitTimeMin', 'returnDate', 'returnTime',
          'startTime', 'endTime', 'returnStartTime', 'returnEndTime',
          'price',
          'paymentMethod', 'paymentStatus', 'walletDeducted', 'remainingDue', 'penaltyIncluded',
          'pointsEarned', 'pointsRedeemed',
          'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.rideCode)
        && isValidId(data.userId)
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
        && (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 160))
        && (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 40))
        && data.originName is string && data.originName.size() >= 1 && data.originName.size() <= 180
        && (!('originAddress' in data) || (data.originAddress is string && data.originAddress.size() <= 280))
        && (!('originLat' in data) || data.originLat is number)
        && (!('originLng' in data) || data.originLng is number)
        && data.destinationName is string && data.destinationName.size() >= 1 && data.destinationName.size() <= 180
        && (!('destinationAddress' in data) || (data.destinationAddress is string && data.destinationAddress.size() <= 280))
        && (!('destinationLat' in data) || data.destinationLat is number)
        && (!('destinationLng' in data) || data.destinationLng is number)
        && data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 3000
        && data.durationMin is int && data.durationMin > 0 && data.durationMin <= 5000
        && data.category is string && data.category in ['standard', 'exec', 'roundtrip']
        && data.isRoundTrip is bool
        && (!('recurrenceFrequency' in data) || (data.recurrenceFrequency is string && data.recurrenceFrequency in ['none', 'daily', 'weekly', 'monthly']))
        && (!('preferences' in data) || (data.preferences is string && data.preferences.size() <= 300))
        && data.scheduledDate is string && data.scheduledDate.size() >= 8 && data.scheduledDate.size() <= 20
        && data.scheduledTime is string && data.scheduledTime.size() >= 4 && data.scheduledTime.size() <= 10
        && (!('totalOccupiedMin' in data) || (data.totalOccupiedMin is int && data.totalOccupiedMin >= 1 && data.totalOccupiedMin <= 5000))
        && (!('safetyMarginMin' in data) || (data.safetyMarginMin is int && data.safetyMarginMin >= 0 && data.safetyMarginMin <= 240))
        && (!('roundTripMode' in data) || (data.roundTripMode is string && data.roundTripMode in ['continuous', 'scheduled_return']))
        && (!('waitTimeMin' in data) || (data.waitTimeMin is int && data.waitTimeMin >= 0 && data.waitTimeMin <= 1440))
        && (!('returnDate' in data) || (data.returnDate is string && data.returnDate.size() <= 20))
        && (!('returnTime' in data) || (data.returnTime is string && data.returnTime.size() <= 10))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 40))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 40))
        && (!('returnStartTime' in data) || (data.returnStartTime is string && data.returnStartTime.size() <= 40))
        && (!('returnEndTime' in data) || (data.returnEndTime is string && data.returnEndTime.size() <= 40))
        && data.price is number && data.price >= 15 && data.price <= 50000
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 60))
        && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus.size() <= 80))
        && (!('walletDeducted' in data) || (data.walletDeducted is number && data.walletDeducted >= 0 && data.walletDeducted <= 50000))
        && (!('remainingDue' in data) || (data.remainingDue is number && data.remainingDue >= 0 && data.remainingDue <= 50000))
        && (!('penaltyIncluded' in data) || (data.penaltyIncluded is number && data.penaltyIncluded >= 0 && data.penaltyIncluded <= 10000))
        && data.pointsEarned is int && data.pointsEarned >= 0 && data.pointsEarned <= 100000
        && (!('pointsRedeemed' in data) || (data.pointsRedeemed is int && data.pointsRedeemed >= 0 && data.pointsRedeemed <= 100000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.status is string && data.status in ['Confirmado', 'Em Andamento', 'Concluído', 'Cancelado']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWalletTopup(data) {
      return data.keys().hasAll(['requestCode', 'userId', 'amount', 'pixKey', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'requestCode', 'userId', 'userName', 'userEmail', 'userPhone',
          'amount', 'pixKey', 'status', 'adminNotes', 'reviewedAt', 'createdAt'
        ])
        && isValidId(data.requestCode)
        && isValidId(data.userId)
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 120))
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160))
        && (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 40))
        && data.amount is number && data.amount >= 5 && data.amount <= 10000
        && data.pixKey is string && data.pixKey.size() >= 3 && data.pixKey.size() <= 120
        && data.status is string && data.status in ['Pendente', 'Aprovado', 'Rejeitado']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 240))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && data.createdAt is timestamp;
    }

    function isValidVipRequest(data) {
      return data.keys().hasAll(['userId', 'amount', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'userPhone', 'amount', 'notes',
          'status', 'reviewedAt', 'createdAt'
        ])
        && isValidId(data.userId)
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 120))
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160))
        && (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 40))
        && data.amount is number && data.amount >= 1 && data.amount <= 1000
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.status is string && data.status in ['Pendente', 'Aprovado', 'Rejeitado']
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && data.createdAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['adminUid', 'category', 'description', 'amount', 'expenseDate', 'createdAt'])
        && data.keys().hasOnly(['adminUid', 'category', 'description', 'amount', 'expenseDate', 'odometerKm', 'createdAt'])
        && isValidId(data.adminUid)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200
        && data.amount is number && data.amount >= 0 && data.amount <= 100000
        && data.expenseDate is string && data.expenseDate.size() >= 8 && data.expenseDate.size() <= 20
        && (!('odometerKm' in data) || (data.odometerKm is int && data.odometerKm >= 0 && data.odometerKm <= 2000000))
        && data.createdAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['standardKm', 'execKm', 'roundTripKm', 'minFare', 'pixKey', 'whatsapp', 'updatedAt'])
        && data.keys().hasOnly([
          'standardKm', 'execKm', 'roundTripKm', 'minFare',
          'estimatedCostPerKm', 'minMarginPct', 'maxMarginPct', 'safetyMarginMin',
          'pixKey', 'whatsapp', 'updatedAt'
        ])
        && data.standardKm is number && data.standardKm >= 3.0 && data.standardKm <= 100.0
        && data.execKm is number && data.execKm >= 3.0 && data.execKm <= 150.0
        && data.roundTripKm is number && data.roundTripKm >= 3.0 && data.roundTripKm <= 100.0
        && data.minFare is number && data.minFare >= 15.0 && data.minFare <= 500.0
        && (!('estimatedCostPerKm' in data) || (data.estimatedCostPerKm is number && data.estimatedCostPerKm >= 0.3 && data.estimatedCostPerKm <= 20.0))
        && (!('minMarginPct' in data) || (data.minMarginPct is number && data.minMarginPct >= 5.0 && data.minMarginPct <= 90.0))
        && (!('maxMarginPct' in data) || (data.maxMarginPct is number && data.maxMarginPct >= 10.0 && data.maxMarginPct <= 98.0))
        && (!('safetyMarginMin' in data) || (data.safetyMarginMin is int && data.safetyMarginMin >= 0 && data.safetyMarginMin <= 180))
        && data.pixKey is string && data.pixKey.size() >= 3 && data.pixKey.size() <= 120
        && data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 20
        && data.updatedAt is timestamp;
    }

    function isValidPartnerStore(data) {
      return data.keys().hasAll(['name', 'active', 'createdAt'])
        && data.keys().hasOnly(['name', 'logoUrl', 'active', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500))
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidPartnerRaffle(data) {
      return data.keys().hasAll(['partnerName', 'prizeTitle', 'drawDate', 'active', 'createdAt'])
        && data.keys().hasOnly(['partnerName', 'partnerLogoUrl', 'prizeTitle', 'prizeDescription', 'drawDate', 'active', 'createdAt'])
        && data.partnerName is string && data.partnerName.size() >= 2 && data.partnerName.size() <= 120
        && (!('partnerLogoUrl' in data) || (data.partnerLogoUrl is string && data.partnerLogoUrl.size() <= 500))
        && data.prizeTitle is string && data.prizeTitle.size() >= 2 && data.prizeTitle.size() <= 140
        && (!('prizeDescription' in data) || (data.prizeDescription is string && data.prizeDescription.size() <= 300))
        && data.drawDate is string && data.drawDate.size() >= 8 && data.drawDate.size() <= 20
        && data.active is bool
        && data.createdAt is timestamp;
    }

    // -----------------------------------------------------------------
    // Collection Match Rules
    // -----------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerifiedAdminToken();
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().updatedAt == request.time
        && (!('createdAt' in incoming()) || incoming().createdAt == request.time)
        && (
          (isAdmin() && incoming().uid == userId) ||
          (isOwner(userId)
            && incoming().uid == request.auth.uid
            && (!('points' in incoming()) || incoming().points == 0 || incoming().points == 100)
            && (!('pontos' in incoming()) || incoming().pontos == 0 || incoming().pontos == 100)
            && (!('tier' in incoming()) || incoming().tier == 'Bronze')
            && (!('vipActive' in incoming()) || incoming().vipActive == false)
            && (!('isVip' in incoming()) || incoming().isVip == false)
            && (!('walletBalance' in incoming()) || incoming().walletBalance == 0)
            && (!('pendingPenalty' in incoming()) || incoming().pendingPenalty == 0)
            && !('vipExpiresAt' in incoming()))
        );

      allow update: if isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'displayName', 'email', 'phone', 'address', 'cpf',
              'photoUrl', 'photoURL', 'profileCompleted', 'preferences', 'vipPreferences',
              'isVip', 'vipActive', 'walletBalance', 'pendingPenalty', 'points', 'pontos', 'updatedAt'
            ])
            && !incoming().diff(existing()).affectedKeys().hasAny(['vipExpiresAt', 'tier'])
            && (!('isVip' in incoming()) || incoming().isVip == false || ('isVip' in existing() && incoming().isVip == existing().isVip))
            && (!('vipActive' in incoming()) || incoming().vipActive == false || ('vipActive' in existing() && incoming().vipActive == existing().vipActive))
            && (!('points' in incoming()) || !('points' in existing()) ? (!('points' in incoming()) || incoming().points == 0 || incoming().points == 100) : incoming().points <= existing().points)
            && (!('pontos' in incoming()) || !('pontos' in existing()) ? (!('pontos' in incoming()) || incoming().pontos == 0 || incoming().pontos == 100) : incoming().pontos <= existing().pontos)
            && (!('walletBalance' in incoming()) || !('walletBalance' in existing()) ? (!('walletBalance' in incoming()) || incoming().walletBalance == 0) : incoming().walletBalance <= existing().walletBalance))
        );

      allow delete: if false;

      // Split PII Collection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isValidId(userId) && isValidId(docId)
          && isValidUserPrivate(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            (isAdmin() && incoming().uid == userId) ||
            (isOwner(userId) && incoming().uid == request.auth.uid)
          );

        allow update: if isValidId(userId) && isValidId(docId)
          && isValidUserPrivate(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'address', 'cpf', 'photoURL', 'preferences', 'vipPreferences', 'updatedAt'
          ]);

        allow delete: if false;
      }

      // User VIP Vouchers Subcollection
      match /vouchers/{voucherId} {
        allow get: if isValidId(userId) && isValidId(voucherId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isValidId(userId) && isValidId(voucherId)
          && isValidVoucher(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            isAdmin() ||
            (isOwner(userId)
              && incoming().used == false
              && incoming().discountValue in [15, 35, 60]
              && ('pointsCost' in incoming())
              && incoming().pointsCost >= 300
              && getAfter(/databases/$(database)/documents/users/$(userId)).data.points
                 <= get(/databases/$(database)/documents/users/$(userId)).data.points - incoming().pointsCost)
          );

        allow update: if isValidId(userId) && isValidId(voucherId)
          && isValidVoucher(incoming())
          && incoming().userId == existing().userId
          && incoming().voucherCode == existing().voucherCode
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (isOwner(userId)
              && existing().used == false
              && incoming().used == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['used']))
          );

        allow delete: if false;
      }

      // User Digital Wallet Transactions Subcollection
      match /walletTransactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isValidId(userId) && isValidId(txId)
          && isValidWalletTransaction(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().amount <= 0)
          );

        allow update, delete: if false;
      }
    }

    match /rides/{rideId} {
      allow get: if isValidId(rideId) && isVerified() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isVerified() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isValidId(rideId)
        && isVerified()
        && isValidRide(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Confirmado'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isValidId(rideId)
        && isVerified()
        && isValidRide(incoming())
        && incoming().userId == existing().userId
        && incoming().rideCode == existing().rideCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && existing().status != 'Concluído'
            && existing().status != 'Cancelado'
            && incoming().status == 'Cancelado'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /scheduleSlots/{slotId} {
      allow get: if isValidId(slotId) && isVerified();
      allow list: if isVerified() && (resource.data.active is bool);

      allow create: if isValidId(slotId)
        && isVerified()
        && isValidScheduleSlot(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (incoming().sourceType == 'ride' && incoming().userId == request.auth.uid)
        );

      allow update: if isValidId(slotId)
        && isVerified()
        && isValidScheduleSlot(incoming())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid
            && incoming().sourceType == 'ride'
            && incoming().active == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']))
        );

      allow delete: if isValidId(slotId) && isAdmin();
    }

    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(expenseId)
        && isAdmin()
        && isValidExpense(incoming())
        && incoming().adminUid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isValidId(expenseId)
        && isAdmin()
        && isValidExpense(incoming())
        && incoming().adminUid == existing().adminUid
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(expenseId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isVerified();
      allow list: if false;

      allow create, update: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    match /partners/{partnerId} {
      allow get: if isValidId(partnerId) && isVerified();
      allow list: if isVerified() && (resource.data.active is bool || isAdmin());

      allow create: if isValidId(partnerId)
        && isAdmin()
        && isValidPartnerStore(incoming())
        && incoming().createdAt == request.time;

      allow update: if isValidId(partnerId)
        && isAdmin()
        && isValidPartnerStore(incoming())
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(partnerId) && isAdmin();
    }

    match /partnerRaffles/{raffleId} {
      allow get: if isValidId(raffleId) && isVerified();
      allow list: if isVerified() && (resource.data.active is bool || isAdmin());

      allow create: if isValidId(raffleId)
        && isAdmin()
        && isValidPartnerRaffle(incoming())
        && incoming().createdAt == request.time;

      allow update: if isValidId(raffleId)
        && isAdmin()
        && isValidPartnerRaffle(incoming())
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(raffleId) && isAdmin();
    }

    match /walletTopups/{topupId} {
      allow get: if isValidId(topupId) && isVerified() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isVerified() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isValidId(topupId)
        && isVerified()
        && isValidWalletTopup(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pendente'
        && incoming().createdAt == request.time;

      allow update: if isValidId(topupId)
        && isAdmin()
        && isValidWalletTopup(incoming())
        && incoming().userId == existing().userId
        && incoming().requestCode == existing().requestCode
        && incoming().createdAt == existing().createdAt;

      allow delete: if false;
    }

    match /vipRequests/{requestId} {
      allow get: if isValidId(requestId) && isVerified() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isVerified() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isValidId(requestId)
        && isVerified()
        && isValidVipRequest(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pendente'
        && incoming().createdAt == request.time;

      allow update: if isValidId(requestId)
        && isAdmin()
        && isValidVipRequest(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;

      allow delete: if false;
    }
  }
}
